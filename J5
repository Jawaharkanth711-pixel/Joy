# Genetic algo
import random
def f(x):
  return-x**2 + 4*x + 10
pop =[random.uniform(-10, 10) for _ in range(10)]
for gen in range(20):
  new_pop =[]
  for _ in range(10):
    p1 =random.choice(pop)
    p2 =random.choice(pop)
    c =(p1+p2)/2
    if random.random() < 0.01:
      c +=random.uniform(-1, 1)
    new_pop.append(c)
  pop =new_pop
  best = max(pop, key=f)
  print(f"Generation {gen+1}: Best individual- {best}, Fitness- {f(best)}")
best = max(pop, key=f)
print(f"Best solution found: {best}, Fitness: {f(best)}")
